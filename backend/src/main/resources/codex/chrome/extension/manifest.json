{
  "manifest_version": 3,
  "name": "叙芽岛码穹 Chrome Bridge",
  "version": "1.0.0",
  "description": "将码穹已授权的浏览器操作连接到当前 Chrome。",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "码穹浏览器连接"}
}
