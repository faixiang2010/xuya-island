{
  "manifest_version": 3,
  "name": "叙芽岛 Codex Chrome Bridge",
  "version": "1.0.0",
  "description": "将成人 Codex 工作台的已授权浏览器操作连接到当前 Chrome。",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Codex Chrome 连接"}
}
